module default {
    global current_sku_code: str;
    global filter_by_sku: bool;

    type Warehouse {
        required code: str {
            constraint exclusive;
        }
        required region: str;

        required property shelf_units := (
            sum(.<warehouse[is ShelfCount].quantity)
        );

        required property ledger_units := (
            sum(.<warehouse[is LedgerLine].quantity)
        );

        multi link counted_skus := (
            .<warehouse[is ShelfCount].sku
        );

        multi link ledger_skus := (
            .<warehouse[is LedgerLine].sku
        );

        multi link unreconciled_skus := (
            distinct (((.counted_skus) except (.ledger_skus)) union ((.ledger_skus) except (.counted_skus)))
        );

        required property is_balanced := (
            (not exists .unreconciled_skus) and (.shelf_units = .ledger_units)
        );
    }

    type Sku {
        required code: str {
            constraint exclusive;
        }
        required label: str;

        single link sole_warehouse := (
            assert_single((select .<sku[is ShelfCount].warehouse if count(.<sku[is ShelfCount].warehouse) = 1 else <Warehouse>{}))
        );
    }

    type ShelfCount {
        required warehouse: Warehouse;
        required sku: Sku;
        required quantity: int64;
        required tag: str;
    }

    type LedgerLine {
        required warehouse: Warehouse;
        required sku: Sku;
        required quantity: int64;
        required tag: str;
    }
}
