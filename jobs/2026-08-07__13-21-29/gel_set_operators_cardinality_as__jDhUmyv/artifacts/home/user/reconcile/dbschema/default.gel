module default {
    type Warehouse {
        required code: str {
            constraint exclusive;
        }
        required region: str;

        required single shelf_units := (
            with s := (select .<warehouse[is ShelfCount])
            select sum(s.quantity)
        );

        required single ledger_units := (
            with l := (select .<warehouse[is LedgerLine])
            select sum(l.quantity)
        );

        multi counted_skus := (
            select distinct (select .<warehouse[is ShelfCount]).sku
        );

        multi ledger_skus := (
            select distinct (select .<warehouse[is LedgerLine]).sku
        );

        multi unreconciled_skus := (
            select distinct (.counted_skus union .ledger_skus)
            except (.counted_skus intersect .ledger_skus)
        );

        required single is_balanced := (
            not exists .unreconciled_skus
            and .shelf_units = .ledger_units
        );
    }

    type Sku {
        required code: str {
            constraint exclusive;
        }
        required label: str;

        single sole_warehouse := (
            with
                my_counts := .<sku[is ShelfCount],
            select distinct my_counts.warehouse
            filter count(distinct my_counts.warehouse) = 1
            limit 1
        );
    }

    type ShelfCount {
        required warehouse: Warehouse;
        required sku: Sku;
        required quantity: int64;
        required tag: str;
    }

    type LedgerLine {
        required warehouse: Warehouse;
        required sku: Sku;
        required quantity: int64;
        required tag: str;
    }
}
