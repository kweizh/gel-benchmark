module reports {

    alias UnpaidInvoice := (select billing::Invoice filter not .paid);

    alias CustomerBalance := (
        select billing::Customer {
            outstanding := billing::customer_outstanding(.name)
        }
    );

    alias InvoicePlan := (
        select billing::Invoice {
            plan := util::installments(.total_due, .installment_count)
        }
    );
}
