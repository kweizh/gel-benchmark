module default {
    type Warehouse {
        required code: str {
            constraint exclusive;
        }
        required region: str;

        # Sum of every ShelfCount.quantity for this warehouse (0 when there are none).
        required property shelf_units := sum(.<warehouse[is ShelfCount].quantity) ?? 0;

        # Sum of every LedgerLine.quantity for this warehouse (0 when there are none).
        required property ledger_units := sum(.<warehouse[is LedgerLine].quantity) ?? 0;

        # Distinct SKUs that have at least one ShelfCount row in this warehouse.
        multi link counted_skus := .<warehouse[is ShelfCount].sku;

        # Distinct SKUs that have at least one LedgerLine row in this warehouse.
        multi link ledger_skus := .<warehouse[is LedgerLine].sku;

        # Symmetric difference of counted_skus and ledger_skus.
        multi link unreconciled_skus :=
            (.counted_skus except .ledger_skus) union
            (.ledger_skus except .counted_skus);

        # Balanced iff no unreconciled SKUs and the unit totals match.
        required property is_balanced :=
            (not exists .unreconciled_skus) and (.shelf_units = .ledger_units);
    }

    type Sku {
        required code: str {
            constraint exclusive;
        }
        required label: str;

        # The single warehouse in which this SKU has ShelfCount rows, but only
        # when that warehouse is unique. Empty when there are zero such
        # warehouses or two or more. Never raises an error.
        single link sole_warehouse :=
            (select .<sku[is ShelfCount].warehouse limit 1)
            if count(.<sku[is ShelfCount].warehouse) = 1
            else {};
    }

    type ShelfCount {
        required warehouse: Warehouse;
        required sku: Sku;
        required quantity: int64;
        required tag: str;
    }

    type LedgerLine {
        required warehouse: Warehouse;
        required sku: Sku;
        required quantity: int64;
        required tag: str;
    }
}
